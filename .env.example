# FitApp Environment Variables Template

# Supabase Credentials (Client-side)
EXPO_PUBLIC_SUPABASE_URL=https://your-supabase-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google OAuth Client IDs (Optional)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id

# Server Proxy Config (Supabase Edge Function & Cloud Run)
SUPABASE_URL=https://your-supabase-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
CLOUD_RUN_URL=https://your-vertex-proxy.a.run.app
PROXY_TOKEN=your-shared-proxy-token
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1
